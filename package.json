{
  "name": "coverlist",
  "version": "1.0.0",
  "description": "Coverlist: a capa viva da sua playlist, com paradas e prévias reais (Deezer, iTunes e Apple RSS).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "fixtures:record": "tsx scripts/record-fixtures.ts",
    "verify:collections": "tsx scripts/verify-collections.ts",
    "publish:portfolio": "tsx scripts/publish-portfolio.ts",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@tanstack/query-async-storage-persister": "^5.108.4",
    "@tanstack/react-query": "^5.108.4",
    "@tanstack/react-query-persist-client": "^5.108.4",
    "idb-keyval": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^22.20.7",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "msw": "^3.0.7",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
